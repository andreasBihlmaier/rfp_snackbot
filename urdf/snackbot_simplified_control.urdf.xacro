<?xml version="1.0"?>
<robot name="snackbot">
  <link name="base_link">
    <visual name="base_link_visual1">
      <origin xyz="0.05 0.05 0.0078" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.0156"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <visual name="base_link_visual2">
      <origin xyz="0.05 0.05 0.1421" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.253"/>
      </geometry>
      <material name="cyan">
        <color rgba="0 0.8 0.8 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0.050 0.050 0.268" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="10"/>
  </joint>

  <link name="link1">
    <visual name="link1_visual">
      <origin xyz="0.0505 0 0.0375" rpy="0 0 0"/>
      <geometry>
        <box size="0.125 0.025 0.075"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.100 0 0.075" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.09" upper="2.09" effort="10" velocity="10"/>
  </joint>

  <link name="link2">
    <visual name="link2_visual">
      <origin xyz="0.05 0 0.0285" rpy="0 0 0"/>
      <geometry>
        <box size="0.100 0.025 0.057"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.8 0.8 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint3" type="prismatic">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.100 0 0.042" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.345" upper="0" effort="10" velocity="10"/>
  </joint>

  <transmission name="joint3_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint3">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="joint3_motor">
      <mechanicalReduction>-40</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="link3">
    <visual name="link3_visual">
      <origin xyz="0 0 0.172" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.0125 0.40"/>
      </geometry>
      <material name="magenta">
        <color rgba="0.8 0 0.8 1"/>
      </material>
    </visual>
  </link>

  <joint name="ee_joint" type="fixed">
    <parent link="link3"/>
    <child link="ee"/>
    <origin xyz="0.0 0 -0.028" rpy="0 0 0"/>
  </joint>

  <link name="ee">
    <visual name="ee">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.005 0.005 0.005"/>
      </geometry>
      <material name="bright_blue">
        <color rgba="0 0 1.0 1"/>
      </material>
    </visual>
  </link>

  <ros2_control name="sts_system" type="system">
    <hardware>
      <plugin>sts_hardware_interface/STSHardwareInterface</plugin>

      <!-- Required Parameters -->
      <param name="serial_port">$(arg serial_port)</param>  <!-- Serial port path (e.g., /dev/ttyACM0) -->

      <!-- Optional Hardware Parameters (with defaults shown) -->
      <param name="baud_rate">$(arg baud_rate)</param>  <!-- Baud rate: 9600-1000000 (default: 1000000) -->
      <param name="communication_timeout_ms">100</param>  <!-- Serial timeout: 1-1000 ms (default: 100) -->
      <param name="use_sync_write">true</param>  <!-- Enable SyncWrite for multi-motor setups (default: true, disabled for single motor) -->
      <param name="enable_mock_mode">$(arg use_mock)</param>  <!-- Simulation mode without hardware (default: false) -->
      <param name="max_velocity_steps">3400</param>  <!-- Max motor velocity in steps/s: STS3215=3400, STS3032=2900 (default: 3400) -->
      <param name="reset_states_on_activate">true</param>  <!-- Reset position/velocity to zero on activation (default: true) -->
    </hardware>

    <joint name="joint1">
      <!-- Required Joint Parameters -->
      <param name="motor_id">1</param>  <!-- Motor ID on serial bus: 1-253 -->

      <!-- Optional Joint Parameters (with defaults shown) -->
      <param name="operating_mode">1</param>  <!-- 0=Position (servo), 1=Velocity (wheel), 2=PWM (effort) [default: 1] -->
      <param name="min_position">-1.57</param>  <!-- Min position limit in radians (default: 0.0) -->
      <param name="max_position">1.57</param>  <!-- Max position limit in radians (default: 6.283, 2π) -->
      <param name="max_velocity">5.22</param>  <!-- Max velocity limit in rad/s (default: 5.22, STS3215 max) -->
      <param name="position_center_steps">0</param>  <!-- Motor step mapped to 0 rad: 0-4095 (default: 4095 → [0, 2π); set to 2048 for [−π, +π]) -->

      <!-- Command Interfaces (Mode 0: Position) -->
      <!-- <command_interface name="position"/> -->  <!-- Target position in radians -->
      <command_interface name="velocity"/>  <!-- Max speed in rad/s -->
      <command_interface name="acceleration"/>  <!-- Acceleration value: 0-254 (unitless protocol value) -->

      <!-- State Interfaces (always exported, declarations optional but recommended) -->
      <state_interface name="position"/>  <!-- Current position (radians) -->
      <state_interface name="velocity"/>  <!-- Current velocity (rad/s) -->
      <state_interface name="effort"/>  <!-- Motor load (-1.0 to +1.0, normalized) -->
      <state_interface name="voltage"/>  <!-- Supply voltage (volts) -->
      <state_interface name="temperature"/>  <!-- Internal temperature (°C) -->
      <state_interface name="current"/>  <!-- Motor current draw (amperes) -->
      <state_interface name="is_moving"/>  <!-- Motion status (1.0=moving, 0.0=stopped) -->
    </joint>

    <joint name="joint2">
      <!-- Required Joint Parameters -->
      <param name="motor_id">2</param>  <!-- Motor ID on serial bus: 1-253 -->

      <!-- Optional Joint Parameters (with defaults shown) -->
      <param name="operating_mode">1</param>  <!-- 0=Position (servo), 1=Velocity (wheel), 2=PWM (effort) [default: 1] -->
      <param name="min_position">-2.09</param>  <!-- Min position limit in radians (default: 0.0) -->
      <param name="max_position">2.09</param>  <!-- Max position limit in radians (default: 6.283, 2π) -->
      <param name="max_velocity">5.22</param>  <!-- Max velocity limit in rad/s (default: 5.22, STS3215 max) -->
      <param name="position_center_steps">0</param>  <!-- Motor step mapped to 0 rad: 0-4095 (default: 4095 → [0, 2π); set to 2048 for [−π, +π]) -->

      <!-- Command Interfaces (Mode 0: Position) -->
      <!-- <command_interface name="position"/> -->  <!-- Target position in radians -->
      <command_interface name="velocity"/>  <!-- Max speed in rad/s -->
      <command_interface name="acceleration"/>  <!-- Acceleration value: 0-254 (unitless protocol value) -->

      <!-- State Interfaces (always exported, declarations optional but recommended) -->
      <state_interface name="position"/>  <!-- Current position (radians) -->
      <state_interface name="velocity"/>  <!-- Current velocity (rad/s) -->
      <state_interface name="effort"/>  <!-- Motor load (-1.0 to +1.0, normalized) -->
      <state_interface name="voltage"/>  <!-- Supply voltage (volts) -->
      <state_interface name="temperature"/>  <!-- Internal temperature (°C) -->
      <state_interface name="current"/>  <!-- Motor current draw (amperes) -->
      <state_interface name="is_moving"/>  <!-- Motion status (1.0=moving, 0.0=stopped) -->
    </joint>

    <joint name="joint3">
      <!-- Required Joint Parameters -->
      <param name="motor_id">3</param>  <!-- Motor ID on serial bus: 1-253 -->

      <!-- Optional Joint Parameters (with defaults shown) -->
      <param name="operating_mode">1</param>  <!-- 0=Position (servo), 1=Velocity (wheel), 2=PWM (effort) [default: 1] -->
      <param name="min_position">-0.345</param>  <!-- Min position limit in radians (default: 0.0) -->
      <param name="max_position">0.0</param>  <!-- Max position limit in radians (default: 6.283, 2π) -->
      <param name="max_velocity">5.22</param>  <!-- Max velocity limit in rad/s (default: 5.22, STS3215 max) -->
      <param name="position_center_steps">0</param>  <!-- Motor step mapped to 0 rad: 0-4095 (default: 4095 → [0, 2π); set to 2048 for [−π, +π]) -->

      <!-- Command Interfaces (Mode 0: Position) -->
      <!-- <command_interface name="position"/> -->  <!-- Target position in radians -->
      <command_interface name="velocity"/>  <!-- Max speed in rad/s -->
      <command_interface name="acceleration"/>  <!-- Acceleration value: 0-254 (unitless protocol value) -->

      <!-- State Interfaces (always exported, declarations optional but recommended) -->
      <state_interface name="position"/>  <!-- Current position (radians) -->
      <state_interface name="velocity"/>  <!-- Current velocity (rad/s) -->
      <state_interface name="effort"/>  <!-- Motor load (-1.0 to +1.0, normalized) -->
      <state_interface name="voltage"/>  <!-- Supply voltage (volts) -->
      <state_interface name="temperature"/>  <!-- Internal temperature (°C) -->
      <state_interface name="current"/>  <!-- Motor current draw (amperes) -->
      <state_interface name="is_moving"/>  <!-- Motion status (1.0=moving, 0.0=stopped) -->
    </joint>
  </ros2_control>
</robot>